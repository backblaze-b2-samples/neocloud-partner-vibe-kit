# Neocloud/Partner Vibe Kit — concept demo settings.
#
# Copy this file to .env and fill in the values for a THROWAWAY B2 bucket:
#   cp .env.example .env
#
# The application key needs read + write + delete on that bucket.
# NEVER use the operator master key here — it is for the control plane only,
# and Backblaze rejects it at the S3 protocol layer anyway.
# .env is git-ignored; do not commit real credentials.

# S3-compatible endpoint for your bucket's region.
# Get it from b2_authorize_account -> apiInfo.storageApi.s3ApiUrl (do not hand-build it).
# Example shape only — substitute your bucket's actual region endpoint:
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# The application key ID (used as the AWS-style access key id via SigV4).
B2_KEY_ID=your_application_key_id

# The application key secret (used as the AWS-style secret access key).
B2_APPLICATION_KEY=your_application_key

# The throwaway bucket the demo uploads to and cleans up.
B2_BUCKET_NAME=your-throwaway-bucket
